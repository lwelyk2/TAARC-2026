mapscripts HamHamClubhouse_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: Clubhouse_IntroCutscene
    ]
    MAP_SCRIPT_ON_LOAD: Clubhouse_CheckForPanda
}

script Clubhouse_CheckForPanda {
    if(flag(FLAG_GAVE_PANDA_HAMMER)) {
        if(flag(FLAG_GOT_SNOOZER)) {
             call(Clubhouse_PandaWork)
        }
    }
    return
}

script Clubhouse_PandaWork {
        setmetatile(2, 2, 0x0D5, FALSE)
        setmetatile(3, 2, 0x0D6, FALSE)
        setmetatile(4, 2, 0x0D7, FALSE)
        setmetatile(2, 3, 0x0DD, FALSE)
        setmetatile(3, 3, 0x0DE, FALSE)
        setmetatile(4, 3, 0x0DF, FALSE)
}

script Clubhouse_IntroCutscene {
    if(flag(FLAG_INTRO_DONE)){
        setvar(VAR_TEMP_0, 1)
    } else {
        setvar(VAR_TEMP_0, 1)
        setflag(FLAG_INTRO_DONE)
        lock
        applymovement(LOCALID_BOSS_BLOCKING, moves(walk_down walk_right * 2 walk_left * 2 walk_up * 2 walk_down))
        applymovement(LOCALID_PLAYER, moves(delay_16 walk_down * 2 face_up))
        turnobject(LOCALID_BOSS,DIR_SOUTH)
        turnobject(LOCALID_PLAYER,DIR_NORTH)
        waitmovement(LOCALID_BOSS_BLOCKING)
        createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
        setspeaker("Boss")
        msgbox("Alright! I think everyone's playing\nin Acorn Park as usual, so you should\llook for them there and see if you can\llearn somet new Hamchat while you're\lat it!")
        release
    }
}

script ClubhouseBlockingBoss {
    lock
    dynmultichoice(1, 1, FALSE, 4,0, DYN_MULTICHOICE_CB_NONE, gText_Hamha, gText_HifHif, gText_TackQ, gText_DigDig)
    switch(var(VAR_RESULT)) {
        case 0:
            call(Common_EventSCript_MoveToFront)
            call(Common_EventScript_Hamha)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            break
        case 1:
            call(Common_EventScript_HifHif)
            msgbox("Smells like BOSS")
            release
            end
        case 2:
            call(Common_EventSCript_MoveToFront)
            call(Common_EventScript_TackQ)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
            setspeaker("Boss")
            msgbox("Hey! We're not doing a battle right now!\pDon't {COLOR RED}TACK-Q{COLOR DARK_GRAY} me!")
            release
            end
        case 3:
            call(Common_EventScript_DigDig)
            msgbox("Nothing there...$")
            createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
            setspeaker("Boss")
            msgbox("I appreciate the enthusiasm Hamtaro,\nbut let's let PANDA do all the\lrenovations.")
            release
            end
    }
    createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
    setspeaker("Boss")
    msgbox("Hamtaro, keep looking for everyone,\nit's no fun without the whole gang!")
    release
    end
}

script ClubhouseBoss {
    lock
    dynmultichoice(1, 1, FALSE, 4,0, DYN_MULTICHOICE_CB_NONE, gText_Hamha, gText_HifHif, gText_TackQ, gText_DigDig)
    switch(var(VAR_RESULT)) {
        case 0:
            call(Common_EventSCript_MoveToFront)
            call(Common_EventScript_Hamha)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            waitmovement
            break
        case 1:
            call(Common_EventScript_HifHif)
            msgbox("Smells like BOSS")
            release
            end
        case 2:
            call(Common_EventSCript_MoveToFront)
            call(Common_EventScript_TackQ)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            applymovement(LOCALID_BOSS_SITTING, face_down)
            waitmovement
            createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
            setspeaker("Boss")
            msgbox("Hey! We're not doing a battle right now!\pDon't {COLOR RED}TACK-Q{COLOR DARK_GRAY} me!")
            release
            end
        case 3:
            call(Common_EventScript_DigDig)
            msgbox("Nothing there...$")
            faceplayer
            createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
            setspeaker("Boss")
            msgbox("I appreciate the enthusiasm Hamtaro,\nbut let's let PANDA do all the\lrenovations.")
            release
            end
    }
    createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
    setspeaker("Boss")
    if(flag(FLAG_NEED_SNOOZER)){
        faceplayer
        msgbox("I hope PANDA finishes up soon, it's\nso {COLOR RED}DINGBANG{COLOR DARK_GRAY} in here while he's working.")
        if(checkitem(ITEM_TM_UPROAR) == FALSE){
            applymovement(LOCALID_PLAYER, dingbang)
            waitmovement
            setspeaker(SP_NAME_NONE)
            message(format("You learned {COLOR RED}Dingbang!$"))
            playse(MUS_RG_OBTAIN_KEY_ITEM)
            additem(ITEM_TM_UPROAR, 1)
            applymovement(LOCALID_PLAYER, emote_x)
            waitmovement
            waitse
            waitmessage
            waitbuttonpress
            closemessage
            applymovement(LOCALID_PLAYER, moves(face_up))
            waitmovement
        }
    } else {
        msgbox("Hamtaro, keep looking for everyone,\nit's no fun without the whole gang!")
    }
    release
    end
}

script HamHamClubhouse_PandaWorking {
    lock
    dynmultichoice(1, 1, FALSE, 4,0, DYN_MULTICHOICE_CB_NONE, gText_Hamha, gText_HifHif, gText_TackQ, gText_DigDig)
    switch(var(VAR_RESULT)) {
        case 0:
            call(Common_EventSCript_MoveToFront)
            call(Common_EventScript_Hamha)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            break
        case 1:
            call(Common_EventScript_HifHif)
            msgbox("Smells like PANDA")
            release
            end
        case 2:
            call(Common_EventSCript_MoveToFront)
            call(Common_EventScript_TackQ)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            faceplayer
            createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
            setspeaker("Panda")
            msgbox("Hamtaro! I can handle the construction.\pSee if BOSS needs help with something.")
            release
            end
        case 3:
            call(Common_EventScript_DigDig)
            msgbox("Nothing there...$")
            faceplayer
            createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
            setspeaker("Panda")
            msgbox("Thanks HAMTARO, but I can handle all\nthe renovations.\pMaybe see if BOSS needs help.")
            applymovement(LOCALID_PANDA_WORKING, face_up)
            release
            end
    }
    faceplayer
    createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
    setspeaker("Panda")
    msgbox("Hey HAMTARO, I'm hard at work on the\nnew arena room.\pYou should see if BOSS needs help\nwith anything.")
    applymovement(LOCALID_PANDA_WORKING, face_up)
    release
    end

}

