script Clubhouse_Snoozer {
    lock
    dynmultipush(gText_Hamha, 0)
    dynmultipush(gText_HifHif, 1)
    dynmultipush(gText_TackQ, 2)
    dynmultipush(gText_DigDig, 3)
    if(checkitem(ITEM_TM_UPROAR)) {
        dynmultipush(AcornParkSouthDingBang, 4)
    } else {
        dynmultipush(AcornParkSouthQuestionMarks, 4)
    }
    dynmultistack(1, 1, FALSE, 5, 0, 0, DYN_MULTICHOICE_CB_NONE)
    switch(var(VAR_RESULT)) {
        case 0:
            call(Common_EventScript_Hamha)
            createfieldmugshot(MUGSHOT_SNOOZER, EMOTE_NORMAL)
            setspeaker("Snoozer")
            msgbox("Zzzzzzzzzzzzzzzzzzzz...$")
            
            break
        case 1:
            call(Common_EventScript_HifHif)
            msgbox("Smells like Snoozer$")
            createfieldmugshot(MUGSHOT_SNOOZER, EMOTE_NORMAL)
            setspeaker("Snoozer")
            msgbox("Zzzzzzzzzzzzzzzzzzzz...$")
            
            break
        case 2:
            call(Common_EventScript_TackQ)
            createfieldmugshot(MUGSHOT_SNOOZER, EMOTE_NORMAL)
            setspeaker("Snoozer")
            msgbox("Zzzzzzzzzzzzzzzzzzzz...$")
            removefieldmugshot
            setspeaker(NULL)
            msgbox("He's still asleep...$")
            applymovement(LOCALID_PLAYER, moves(face_down))
            waitmovement
            msgbox("How did he sleep through that?!?!$")
            break
        case 3:
            call(Common_EventScript_DigDig)
            msgbox(format("There's a little bit of dirt on Snoozer now, but he's still sleeping through it.$"))
            break
        case 4:
            if(checkitem(ITEM_TM_DINGBANG)) {
                // Insert Dingbang graphics here
                createfieldmugshot(MUGSHOT_HAMTARO, EMOTE_NORMAL)
                setspeaker("Hamtaro")
                message("DingBang!$")
                applymovement(LOCALID_PLAYER, dingbang)
                waitmovement
                waitmessage
                waitbuttonpress
                applymovement(LOCALID_SNOOZER, moves(
                    walk_in_place_up
                ))
                waitmovement
                createfieldmugshot(MUGSHOT_SNOOZER, EMOTE_NORMAL)
                setspeaker("Snoozer")
                msgbox("Huh? what's going on?\nWhy is it so noisy?")
                applymovement(LOCALID_SNOOZER, moves(
                    walk_in_place_left
                ))
                waitmovement
                msgbox("Oh, I'm in the clubhouse now...")
                applymovement(LOCALID_SNOOZER,moves(face_down))
                break
            }
    }
    release
    end
}