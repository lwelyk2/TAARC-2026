mapscripts Hamtaro_AcornParkSouth_MapScripts {
    MAP_SCRIPT_ON_LOAD: AcornPark_LadderCheck
}

script AcornPark_LadderCheck {
    if(flag(FLAG_GAVE_PANDA_HAMMER)) {
        call(AcornPark_FixLadder)
    }
    return
}

script AcornPark_FixLadder {
        setmetatile(4, 5, 0x0DA, FALSE)
        setmetatile(4, 6, 0x0E2, FALSE)
        setmetatile(4, 7, 0x0EA, FALSE)
        setmetatile(4, 8, 0x0F2, FALSE)
        setmetatile(4, 9, 0x0FA, FALSE)
        setmetatile(5, 5, 0x0DB, FALSE)
        setmetatile(5, 6, 0x0E3, FALSE)
        setmetatile(5, 7, 0x0EB, FALSE)
        setmetatile(5, 8, 0x0F3, FALSE)
        setmetatile(5, 9, 0x0FB, FALSE)
        setmetatile(6, 5, 0x0DC, FALSE)
        setmetatile(6, 6, 0x0E4, FALSE)
        setmetatile(6, 7, 0x0EC, FALSE)
        setmetatile(6, 8, 0x0F4, FALSE)
        setmetatile(6, 9, 0x0FC, FALSE)
}

script AcornParkSouthSoccerHam {
    lock
    dynmultipush(gText_Hamha, 0)
    dynmultipush(gText_HifHif, 1)
    dynmultipush(gText_TackQ, 2)
    dynmultipush(gText_DigDig, 3)
    if(checkitem(ITEM_TM_ASTONISH)) {
        dynmultipush(AcornParkSouthShockie, 4)
    } else {
        dynmultipush(AcornParkSouthQuestionMarks, 4)
    }
    dynmultistack(1, 1, FALSE, 5, 0, 0, DYN_MULTICHOICE_CB_NONE)
    switch(var(VAR_RESULT)) {
        case 0:
            call(Common_EventScript_MoveToFront)
            break
        case 1:
            call(Common_EventScript_HifHif)
            msgbox("Smells like strawberries...\pand sweat.$")
            release
            end
        case 2:
            call(Common_EventScript_MoveToFront)
            call(Common_EventScript_TackQ)
            applymovement(LOCALID_SOCCER_HAM,moves(walk_in_place_up))
            msgbox("Ha! You think that would hurt me?\pI'm made of tougher stuff than that!")
            applymovement(LOCALID_SOCCER_HAM, moves(walk_in_place_down))
            release
            end
        case 3:
            call(Common_EventScript_DigDig)
            getobjectfacingdirection(LOCALID_PLAYER, VAR_TEMP_1)
            switch (var(VAR_TEMP_1)) {
                case DIR_EAST:
                    applymovement(LOCALID_PLAYER, moves(face_left))
                    waitmovement
                case DIR_WEST:
                    applymovement(LOCALID_PLAYER, moves(face_right))
                    waitmovement
                default:
                    break
            }
            msgbox("Hahaha! You think I'd hide it there?\nerrr... I mean.\pWhy are you digging here? You're just\nmaking a mess!")
            release
            end
        case 4:
            if(flag(FLAG_FOUGHT_SOCCER_HAM)) {
                break
            }
            if(checkitem(ITEM_TM_ASTONISH)){
                msgbox("Huh? SHOCKIE?\pOh, the ladder? Yeah that's a strange\none. I wonder who could have done that?\pI think that Hamster should spend more\ntime keeping track of his hammer and\lless time helping other Hamsters make\lnew sports that are worse than\lStrawberry Soccer.")
                applymovement(LOCALID_SOCCER_HAM,moves(emote_exclamation_mark))
                playse(SE_PIN)
                waitmovement
                waitse
                msgbox("Uhh I mean, assuming he had a hammer.\pThat he lost.\pAnd wasn't stolen.\pI mean you'd have to be a real {COLOR RED}DELIN-Q{COLOR DARK_GRAY}\nto do something like steal a tool.")
                // applymovement(LOCALID_PLAYER, moves(delinq))
                waitmovement
                setspeaker(SP_NAME_NONE)
                message(format("You learned {COLOR RED}DELIN-Q!$"))
                playse(MUS_RG_OBTAIN_KEY_ITEM)
                additem(ITEM_TM_THIEF, 1)
                applymovement(LOCALID_PLAYER, AcornParkSouthDictionary)
                waitmovement
                waitse
                waitmessage
                waitbuttonpress
                closemessage
                applymovement(LOCALID_PLAYER, moves(face_up))
                waitmovement
                msgbox("What, who are you calling DELIN-Q?\pThat's it!")
                applymovement(LOCAL_ID_SOCCER_HAM, moves(walk_in_place_right))
                waitmovement
                msgbox("It's time for me to teach you a lesson!")
                call(SoccerHamBattleHandler)
            }
    }
    if(flag(FLAG_FOUGHT_SOCCER_HAM)) {
        msgbox("Well, well, well. It seems you didn't learn\nyour lesson the last time.")
        applymovement(LOCAL_ID_SOCCER_HAM, moves(walk_in_place_right))
        waitmovement
        msgbox("Get ready for a beating!")
        call(SoccerHamBattleHandler)
    } else {
        msgbox("Ham-howdy! You must be one of those\nHamHams who are always around here\lhaving adventures.\pYou should give up on this stupid new\nHam-battle idea and play some good old\lstrawberry soccer!")
        applymovement(LOCALID_SOCCER_HAM,moves(walk_in_place_up))
        waitmovement
        release
        end
    }

}


script SoccerHamBattleHandler {
    setflag(FLAG_FOUGHT_SOCCER_HAM)
    setflag(FLAG_NO_WHITEOUT)
    setwildbattle(SPECIES_STRAWBERRY_SOCCER_HAM, 5, ITEM_LEFTOVERS)
	dowildbattle
    specialvar(VAR_RESULT, GetBattleOutcome)
    switch(var(VAR_RESULT)) {
        case B_OUTCOME_WON:
            msgbox("No way! You can't beat me! Not with\nall of my training!")
            applymovement(LOCALID_SOCCER_HAM,moves(walk_up))
            waitmovement(LOCALID_SOCCER_HAM)
            playse(SE_EXIT)
            removeobject(LOCALID_SOCCER_HAM)
            waitse
        case B_OUTCOME_RAN:
            msgbox("Ha! That's right, run away little Ham!")
            special(HealPlayerParty)
            release 
            end
        case B_OUTCOME_LOST:
            msgbox("I'm still the best!\pWho needs this ham-battle nonsense?\pI got all the strength I need from\nplaying strawberry soccer.")
            release
            end
    }
    return
}

script AcornPathSouthPanda {
    lock
    dynmultichoice(1, 1, FALSE, 4,0, DYN_MULTICHOICE_CB_NONE, gText_Hamha, gText_HifHif, gText_TackQ, gText_DigDig)
    switch(var(VAR_RESULT)) {
        case 0:
            call(Common_EventScript_MoveToFront)
            break
        case 1:
            call(Common_EventScript_HifHif)
            msgbox("Smells like PANDA!$")
            release
            end
        case 2:
            call(Common_EventScript_MoveToFront)
            call(Common_EventScript_TackQ)
            applymovement(LOCALID_PANDA,moves(face_down))
            waitmovement
            createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
            speaker("Panda")
            msgbox("Ow! Hamtaro, why would you do that?")
            applymovement(LOCALID_PANDA,moves(face_up))
            waitmovement
            release
            end
        case 3:
            call(Common_EventScript_DigDig)
            msgbox("Nothing there...$")
            release
            end
    }
    call(Common_EventScript_Hamha)
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement
    applymovement(LOCALID_PANDA, moves(walk_in_place_down))
    waitmovement
    createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
    setspeaker("Panda")
    msgbox("Hey Hamtaro, I'm glad you're here!\pI needed to get some extra parts,\nbut I came by this morning and saw this!$")
    applymovement(LOCALID_PANDA, moves(walk_in_place_up))
    waitmovement
    createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
    setspeaker("Panda")
    message("The ladder is broken!$")
    applymovement(LOCALID_PANDA, moves(walk_in_place_down))
    waitmessage
    waitbuttonpress
    closemessage
    createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
    setspeaker("Panda")
    message(format("I was completely {COLOR RED}SHOCKIE{COLOR DARK_GRAY}!$"))
    applymovement(LOCALID_PANDA, AcornParkSouthShockie)
    waitmessage
    waitbuttonpress
    closemessage
	removefieldmugshot
    if(checkitem(ITEM_TM_ASTONISH, 1) == 0) {
        applymovement(LOCALID_PLAYER, AcornParkSouthShockie)
        waitmovement
        setspeaker(SP_NAME_NONE)
        message(format("You learned {COLOR RED}Shockie!$"))
        playse(MUS_RG_OBTAIN_KEY_ITEM)
        additem(ITEM_TM_ASTONISH, 1)
        applymovement(LOCALID_PLAYER, AcornParkSouthDictionary)
        waitmovement
        waitse
        waitmessage
        waitbuttonpress
        closemessage
        applymovement(LOCALID_PLAYER, moves(face_up))
        waitmovement
    }
    if(checkitem(ITEM_HAMMER)) {
        createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
        setspeaker("Panda")
        applymovement(LOCALID_PANDA, moves(emote_exclamation_mark))
        msgbox(format("My Hammer! I've been looking all over for that!\pThanks Hamtaro, now I can fix this ladder! Stand back and I'll get to work!$"))
        applymovement(LOCALID_PANDA, moves(walk_in_place_up))
        waitmovement
        applymovement(LOCALID_PLAYER, moves(
            lock_facing_direction
            walk_down
            unlock_facing_direction
        ))
        waitmovement
        fadescreen(FADE_TO_BLACK)
        playse(SE_M_EARTHQUAKE)
        waitse
        playse(SE_M_DIG)
        waitse
        playse(SE_M_CUT)
        waitse
        call(AcornPark_FixLadder)
        special(DrawWholeMapView)
        fadescreen(FADE_FROM_BLACK)
        setspeaker("Panda")
        createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
        msgbox(format("And that should do it!$"))
        applymovement(LOCALID_PANDA, moves(
            walk_up * 6
            walk_down
        ))
        applymovement(LOCALID_PLAYER, moves(
            walk_up * 2
        ))
        waitmovement
        setspeaker("Panda")
        createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
        msgbox(format("It works and I got the parts I needed!\pThanks for your help Hamtaro! I'll see you at the clubhouse later!$"))
        applymovement(LOCALID_PLAYER, moves(walk_down * 2 walk_right * 2 face_down))
        applymovement(LOCALID_PANDA, moves(
            walk_down * 12
        ))
        waitmovement
        removeobject(LOCALID_PANDA)
        setflag(FLAG_NEED_SNOOZER)
        release
        end
    } else {
        createfieldmugshot(MUGSHOT_PANDA, EMOTE_NORMAL)
        setspeaker("Panda")
        msgbox(format("I can fix this, but my hammer is missing too!\pIf you find it, can you bring it to me?"))
        applymovement(LOCALID_PANDA, moves(walk_in_place_up))
        waitmovement
        release
    }

    end
}

script AcornParkSouthSnoozer {
    lock
    dynmultipush(gText_Hamha, 0)
    dynmultipush(gText_HifHif, 1)
    dynmultipush(gText_TackQ, 2)
    dynmultipush(gText_DigDig, 3)
    if(checkitem(ITEM_TM_UPROAR)) {
        dynmultipush(AcornParkSouthDingBang, 4)
    } else {
        dynmultipush(AcornParkSouthQuestionMarks, 4)
    }
    dynmultistack(1, 1, FALSE, 5, 0, 0, DYN_MULTICHOICE_CB_NONE)
    switch(var(VAR_RESULT)) {
        case 0:
            call(Common_EventScript_Hamha)
            createfieldmugshot(MUGSHOT_SNOOZER, EMOTE_NORMAL)
            setspeaker("Snoozer")
            msgbox("Zzzzzzzzzzzzzzzzzzzz...$")
            
            break
        case 1:
            call(Common_EventScript_HifHif)
            msgbox("Smells like Snoozer$")
            createfieldmugshot(MUGSHOT_SNOOZER, EMOTE_NORMAL)
            setspeaker("Snoozer")
            msgbox("Zzzzzzzzzzzzzzzzzzzz...$")
            
            break
        case 2:
            call(Common_EventScript_TackQ)
            createfieldmugshot(MUGSHOT_SNOOZER, EMOTE_NORMAL)
            setspeaker("Snoozer")
            if(checkitem(ITEM_TM_REST)) {
                msgbox("Zzzzzzzzzzzzzzzzzzzz...$")
                
            } else {
                msgbox("Zzzzz... I'm {COLOR RED}Zuzuzu$")
                
                // Show Zuzuzu graphics here
                // waitmovement
                setspeaker(SP_NAME_NONE)
                message(format("You learned {COLOR RED}Zuzuzu!$"))
                playse(MUS_RG_OBTAIN_KEY_ITEM)
                additem(ITEM_TM_REST, 1)
                applymovement(LOCALID_PLAYER, AcornParkSouthDictionary)
                waitmovement
                waitse
                waitmessage
                waitbuttonpress
                closemessage
                applymovement(LOCALID_PLAYER, moves(face_up))
                waitmovement
            }
            msgbox("He's still asleep...$")
            applymovement(LOCALID_PLAYER, moves(face_down))
            waitmovement
            msgbox("How did he sleep through that?!?!$")
            break
        case 3:
            call(Common_EventScript_DigDig)
            msgbox(format("There's a little bit of dirt on Snoozer now, but he's still sleeping through it.$"))
            break
        case 4:
            if(checkitem(ITEM_TM_DINGBANG)) {
                // Insert Dingbang graphics here
                createfieldmugshot(MUGSHOT_HAMTARO, EMOTE_NORMAL)
                setspeaker("Hamtaro")
                message("DingBang!$")
                applymovement(LOCALID_PLAYER, dingbang)
                waitmovement
                waitmessage
                waitbuttonpress
                applymovement(LOCALID_SNOOZER, moves(
                    walk_in_place_up
                ))
                waitmovement
                createfieldmugshot(MUGSHOT_SNOOZER, EMOTE_NORMAL)
                setspeaker("Snoozer")
                msgbox("Huh? what's going on? Why is it so noisy...")
                applymovement(LOCALID_SNOOZER, moves(
                    walk_in_place_left
                ))
                waitmovement
                msgbox("Oh, back to the clubhouse?\pSure thing. I guess I can do that...")
                fadescreen(FADE_TO_BLACK)
                setflag(FLAG_GOT_SNOOZER)
                playse(SE_EXIT)
                waitse
                fadescreen(FADE_FROM_BLACK)
                break
            }
    }
    release
    end
}

script AcornPark_OxnardsSunflowerSeed {
    lock
    dynmultichoice(1, 1, FALSE, 4,0, DYN_MULTICHOICE_CB_NONE, gText_Hamha, gText_HifHif, gText_TackQ, gText_DigDig)
    switch(var(VAR_RESULT)) {
        case 0:
            call(CommonEventScript_Hamha)
            release
            end
        case 1:
            call(CommonEventScript_Hifhif)
            giveitem(ITEM_SUNFLOWER_SEED)
            removeobject(LOCALID_SEED)
            release
            end
        case 2:
            call(CommonEventScript_TackQ)
            release
            end
        case 3:
            call(CommonEventScript_DigDig)
            msgbox("Nothing here...")
            release
            end
    }

}

