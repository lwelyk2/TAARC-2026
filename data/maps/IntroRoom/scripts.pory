mapscripts IntroRoom_MapScripts { 
    MAP_SCRIPT_ON_LOAD: IntroRoom_TurnHamtaro
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: IntroCutscene
    ]
}

script IntroRoom_TurnHamtaro {
    applymovement(LOCALID_PLAYER, moves(
        face_up
    ))
    end
}
script IntroCutscene {
    setflag(VAR_TEMP_0)
    setflag(FLAG_NOT_GOT_PANDA)
    lockall
    applymovement(LOCALID_PLAYER, moves(
        face_up
        emote_double_exclamation_mark
    ))
    createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
    setspeaker("Boss")
    message("... and the dance parties just aren't\nas popular anymore.$")
    applymovement(LOCALID_PLAYER, moves(emote_double_exclamation_mark))
    applymovement(LOCALID_BOSS, moves(
        walk_left
        walk_left
    ))
    waitmovement
    waitbuttonpress
    message("So, I got to thinking, Ham-chat's still\ncool, but how else can we use it?$")
    applymovement(LOCALID_PLAYER, moves(emote_double_exclamation_mark))
    applymovement(LOCALID_BOSS, moves(
        walk_right
        walk_right
        walk_right
        walk_right
    ))
    waitmovement
    waitbuttonpress
    message("So that's when I...")
    applymovement(LOCALID_PLAYER, moves(emote_double_exclamation_mark))
    applymovement(LOCALID_BOSS, moves(
        face_down
    ))
    waitmovement
    waitbuttonpress
    message("...wait...")
    applymovement(LOCALID_PLAYER, moves(emote_double_exclamation_mark))
    applymovement(LOCALID_BOSS, moves(
        walk_left
        walk_left
        walk_down
    ))
    waitmovement
    waitbuttonpress
    createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
    setspeaker("Boss")
    message("Hey, Hamtaro! Stop falling asleep while\nI'm talking to you!")
    applymovement(LOCALID_PLAYER, moves(emote_double_exclamation_mark, delay_16))
    waitmovement(LOCALID_PLAYER)
    createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
    applymovement(LOCALID_BOSS, moves(
        walk_left
        walk_left
        walk_down
        walk_down
        walk_down
        walk_down
        walk_right
        walk_right
        walk_up
    ))
    waitmovement(LOCALID_BOSS)
    waitmessage
    waitbuttonpress
    applymovement(LOCALID_PLAYER, moves(emote_double_exclamation_mark, delay_16))
    waitmovement(LOCALID_PLAYER)
    createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
    setspeaker("Boss")
    applymovement(LOCALID_BOSS, moves(tackq, delay_16))
    message("{COLOR RED}TACK-Q!{PLAY_SE SE_M_COMET_PUNCH}$")
    waitmovement
    waitse
    waitmessage
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(
        emote_exclamation_mark
        delay_16
        face_down
    ))
    waitse
    applymovement(LOCALID_BOSS, moves(walk_down))
    waitmovement(LOCALID_BOSS)
    turnobject(LOCALID_BOSS, DIR_NORTH)
    waitbuttonpress
    createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
    setspeaker("Boss")
    message("Now, as I was saying, we need\nto find a new, more exciting way to\luse Ham-chat!$")
    applymovement(LOCALID_BOSS, moves(
        walk_left
        walk_left
        walk_up
        walk_up
    ))
    waitmovement(LOCALID_BOSS)
    turnobject(LOCALID_PLAYER, DIR_WEST)
    applymovement(LOCALID_BOSS, moves(
        walk_up
        walk_up
        walk_up
        walk_right
        walk_right
        walk_down
    ))
    waitmovement(LOCALID_BOSS)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    waitmessage
    waitbuttonpress
    givemon(SPECIES_HAMTARO, 100, ITEM_SITRUS_BERRY)
    message("It hit me when I saw a video game!\pWe'll have a tournament where strength,\ncunning, and knowledge of hamchat are \lthe key to victory!\pHere, let's give it a shot!$")
    setflag(FLAG_USED_ROOM_1_KEY)
    waitmessage
    waitbuttonpress
    closemessage
    call(IntroBattleHandler)
	specialvar(VAR_RESULT, GetBattleOutcome)
    createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
    setspeaker("Boss")
    switch(var(VAR_RESULT)) {
        case B_OUTCOME_WON:
            msgbox("Wow, you're really good at this HAMTARO!")
        case B_OUTCOME_RAN:
            msgbox("Come on HAMTARO, it's not fun if you\ngive up right away.\pLet's do it again for real this time!")
            special(HealPlayerParty)
            call(IntroBattleHandler)
        case B_OUTCOME_LOST:
            msgbox("Only makes sense that I'd win this\nfirst one since I invented it.\pYou'll get better with practice.")
            end
    }
    message("Now, let me give you a new\nHamchat Dictionary.\pThis has the words you just used and\nthe ones you saw me use.")
    waitmessage
    waitbuttonpress
    closemessage
    applymovement(LOCALID_BOSS, moves(emote_x, delay_16, delay_16, delay_16))
    waitmovement
    applymovement(LOCALID_PLAYER, moves(emote_x, delay_16))
    waitmovement
    turnobject(LOCALID_PLAYER, DIR_SOUTH)
    additem(ITEM_TM_TACKLE, 1)
    additem(ITEM_TM_YAWN, 1)
    additem(ITEM_TM_DIG, 1)
    message("{PLAY_SE MUS_RG_OBTAIN_KEY_ITEM}You received the Hamchat Dictionary!$")
    applymovement(LOCALID_PLAYER, moves(yepp))
    waitse
    waitmessage
    waitbuttonpress
    message("Use it to learn new Hamchat and to\nremember the ones you already know.\pYou can have up to four hamchat ready\nfor a battle at once.$")
    waitmessage
    waitbuttonpress
    closemessage
    message("You learned {COLOR RED}HAMHA{COLOR DARK_GRAY},{COLOR RED}BLAHH{COLOR DARK_GRAY}, \nand {COLOR RED}TACK-Q{COLOR DARK_GRAY}!")
    applymovement(LOCALID_PLAYER, moves(yepp))
    waitmessage
    waitbuttonpress
    closemessage
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    waitmovement
    createfieldmugshot(MUGSHOT_BOSS, EMOTE_NORMAL)
    setspeaker("Boss")
    message("Great! You should be good to get\nto get started now!\pI need your help to get everyone\nback to the clubhouse so we can\lget the tournament started!$")
    waitmessage
    waitbuttonpress
    applymovement(LOCALID_BOSS, moves(emote_exclamation_mark, delay_16))
    playse(SE_PIN)
    waitmovement
    waitse
    message("Oh! And we need PANDA's help to remodel\nthis room for the new tournament!\pCome on Hamtaro, let's get going!$")
    waitmessage
    waitbuttonpress
    applymovement(LOCALID_BOSS, moves(
        walk_down
        walk_right * 17
    ))
    applymovement(LOCALID_PLAYER, moves(
        delay_16
        delay_16
        walk_up
        walk_right * 17
    ))
    waitmovement(LOCALID_BOSS)
    playse(SE_EXIT)
    removeobject(LOCALID_BOSS)
    waitse
    waitmovement(LOCALID_PLAYER)
    warp(MAP_HAM_HAM_CLUBHOUSE, 0)
    waitstate
    releaseall
    end
}

script IntroBattleHandler {
    setflag(FLAG_NO_WHITEOUT)
    setwildbattle(SPECIES_BOSS, 5)
	dowildbattle
    return
}